    {
      "nodeId": "schedule",
      "durationMs": 800,
      "log": "read: sheet · 7 rows",
      "view": "table",
      "output": {
        "columns": ["Post", "Date", "Time", "Platform", "Status"],
        "rows": [
          ["P-001", "2026-10-28", "19:00", "Instagram", "published"],
          ["P-002", "2026-10-30", "14:00", "Facebook", "published"],
          ["P-006", "2026-11-02", "19:00", "Instagram", "scheduled"],
          ["P-003", "2026-11-03", "19:00", "Instagram", "scheduled"],
          ["P-004", "2026-11-05", "19:00", "Instagram", "scheduled"],
          ["P-005", "2026-11-06", "15:00", "WhatsApp", "scheduled"],
          ["P-007", "2026-11-07", "19:00", "Instagram", "scheduled"]
        ]
      }
    },
    {
      "nodeId": "calendar",
      "durationMs": 400,
      "log": "checks the slot in code",
      "view": "json",
      "input": { "date": "2026-11-07", "time": "11:00", "platform": "Instagram" },
      "output": { "tool_call": "check_conflict" }
    },
    {
      "nodeId": "conflict",
      "durationMs": 900,
      "log": "slot is free",
      "view": "json",
      "output": { "ok": true, "slot": "Saturday 2026-11-07 11:00", "is_past": false, "slot_taken": false, "conflicting_posts": [] }
    },
    {
      "nodeId": "calendar",
      "durationMs": 400,
      "log": "asks to add the post",
      "view": "json",
      "output": { "tool_call": "add_to_calendar", "post_id": "P-008", "gate": "human approval required" }
    },
    {
      "nodeId": "approval",
      "durationMs": 1500,
      "log": "workflow paused until the owner approved",
      "view": "json",
      "input": { "tool": "add_to_calendar", "post_id": "P-008", "platform": "Instagram", "date": "2026-11-07", "time": "11:00" },
      "output": { "approved": true }
    },
    {
      "nodeId": "add",
      "durationMs": 900,
      "log": "append: sheet · 1 row",
      "view": "table",
      "output": {
        "columns": ["Post", "Date", "Time", "Platform", "Status", "Created by"],
        "rows": [["P-008", "2026-11-07", "11:00", "Instagram", "scheduled", "AI"]]
      }
    },
    {
      "nodeId": "calendar",
      "durationMs": 500,
      "log": "reports back to the Orchestrator",
      "view": "chat",
      "output": {
        "messages": [
          { "from": "bot", "text": "✅ انضاف للجدول: P-008 — Instagram — السبت 2026-11-07 الساعة 11:00", "translation": "Added to the calendar: P-008, Instagram, Saturday 2026-11-07 at 11:00" }
        ]
      }
    },
    {
      "nodeId": "orchestrator",
      "durationMs": 800,
      "log": "reviews and writes the final answer",
      "view": "text",
      "output": "The calendar agent confirmed the post. One final answer goes back to the owner, in Arabic, because the request was in Arabic."
    },
    {
      "nodeId": "reply",
      "durationMs": 600,
      "log": "text in, so text out",
      "view": "json",
      "output": { "is_voice": false, "format": "text" }
    }
