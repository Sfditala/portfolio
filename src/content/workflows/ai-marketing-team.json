{
  "_placeholder": true,
  "id": "write-and-schedule-post",
  "projectSlug": "ai-marketing-team",
  "title": "Write a post, schedule it, catch the conflict",
  "prompt": "Write me a post about the Cold Brew and schedule it Thursday at 7",
  "nodes": [
    { "id": "trigger", "label": "Telegram", "kind": "trigger", "icon": "telegram", "position": { "x": 16, "y": 228 } },
    { "id": "orchestrator", "label": "Orchestrator", "kind": "agent", "icon": "bot", "position": { "x": 229, "y": 228 } },
    { "id": "content", "label": "Content Agent", "kind": "agent", "icon": "bot", "position": { "x": 442, "y": 50 } },
    { "id": "pinecone", "label": "Brand RAG", "kind": "rag", "icon": "vector", "position": { "x": 655, "y": 50 } },
    { "id": "calendar", "label": "Calendar Agent", "kind": "agent", "icon": "bot", "position": { "x": 442, "y": 228 } },
    { "id": "analyst", "label": "Analyst Agent", "kind": "agent", "icon": "bot", "position": { "x": 442, "y": 410 } },
    { "id": "conflict", "label": "Conflict check", "kind": "tool", "icon": "code", "position": { "x": 655, "y": 170 } },
    { "id": "approval", "label": "Owner approval", "kind": "tool", "icon": "approval", "position": { "x": 655, "y": 300 } },
    { "id": "sheets", "label": "Google Sheets", "kind": "db", "icon": "sheets", "position": { "x": 868, "y": 300 } },
    { "id": "reply", "label": "Telegram", "kind": "output", "icon": "telegram", "position": { "x": 868, "y": 120 } }
  ],
  "edges": [
    { "from": "trigger", "to": "orchestrator" },
    { "from": "orchestrator", "to": "content" },
    { "from": "orchestrator", "to": "calendar" },
    { "from": "orchestrator", "to": "analyst" },
    { "from": "content", "to": "pinecone" },
    { "from": "calendar", "to": "conflict" },
    { "from": "conflict", "to": "approval" },
    { "from": "approval", "to": "sheets" },
    { "from": "sheets", "to": "reply" }
  ],
  "steps": [
    {
      "nodeId": "trigger",
      "durationMs": 700,
      "log": "owner on the allowlist · language detected: en",
      "view": "json",
      "output": { "chat_id": "<redacted>", "input_type": "text", "reply_language": "en", "text": "Write me a post about the Cold Brew and schedule it Thursday at 7" }
    },
    {
      "nodeId": "orchestrator",
      "durationMs": 1200,
      "log": "2 tasks: content, then schedule",
      "view": "text",
      "output": "Two tasks. The Content Agent writes the post first, then the Calendar Agent schedules it."
    },
    {
      "nodeId": "content",
      "durationMs": 900,
      "log": "short, separate searches",
      "view": "json",
      "input": { "task": "Instagram post about the Cold Brew" },
      "output": { "searches": ["Cold Brew", "Instagram rules", "current offers", "tone of voice"] }
    },
    {
      "nodeId": "pinecone",
      "durationMs": 1000,
      "log": "4 searches · brand knowledge",
      "view": "table",
      "output": {
        "columns": ["Search", "Source"],
        "rows": [
          ["Cold Brew", "Menu & prices"],
          ["Instagram rules", "Platform rules"],
          ["Current offers", "Offers"],
          ["Tone of voice", "Brand guide"]
        ]
      }
    },
    {
      "nodeId": "content",
      "durationMs": 1300,
      "log": "caption ready",
      "view": "text",
      "output": "Instagram caption drafted with the café's voice and hashtags, using the price and offer found in the knowledge base."
    },
    {
      "nodeId": "orchestrator",
      "durationMs": 600,
      "log": "post reviewed · delegating to Calendar Agent",
      "view": "text",
      "output": "The post looks right. Now the Calendar Agent can schedule it for Thursday at 7."
    },
    {
      "nodeId": "calendar",
      "durationMs": 800,
      "log": "requested: Thursday 19:00",
      "view": "json",
      "input": { "post": "Cold Brew", "requested": "Thursday 19:00" },
      "output": { "tool_call": "check_conflicts" }
    },
    {
      "nodeId": "conflict",
      "durationMs": 800,
      "log": "slot taken · 2 free slots",
      "view": "json",
      "input": { "slot": "Thursday 19:00" },
      "output": { "conflict": true, "taken_by": "V60 post", "free_slots": ["Thursday 20:00", "Saturday 11:00"] }
    },
    {
      "nodeId": "approval",
      "durationMs": 1500,
      "log": "paused until the owner approves",
      "view": "chat",
      "output": {
        "messages": [
          { "from": "bot", "text": "That slot is taken by the V60 post. Free slots: Thursday 20:00 or Saturday 11:00." },
          { "from": "user", "text": "Saturday 11" },
          { "from": "bot", "text": "Approve adding the Cold Brew post on Saturday at 11:00?" },
          { "from": "user", "text": "Approve" }
        ]
      }
    },
    {
      "nodeId": "sheets",
      "durationMs": 800,
      "log": "append · 1 row, after approval",
      "view": "table",
      "input": { "operation": "append", "sheet": "Content Calendar" },
      "output": {
        "columns": ["Day", "Time", "Post", "Platform", "Status"],
        "rows": [["Saturday", "11:00", "Cold Brew", "Instagram", "Scheduled"]]
      }
    },
    {
      "nodeId": "reply",
      "durationMs": 700,
      "log": "replied in the same format: text",
      "view": "json",
      "output": { "ok": true, "format": "text" }
    }
  ],
  "result": {
    "type": "telegram",
    "data": {
      "bot": "Ben Al-Sabah Marketing Team",
      "messages": [
        { "from": "user", "text": "Write me a post about the Cold Brew and schedule it Thursday at 7" },
        { "from": "bot", "text": "That slot is taken by the V60 post. Free slots: Thursday 20:00 or Saturday 11:00." },
        { "from": "user", "text": "Saturday 11" },
        { "from": "bot", "text": "Done. The Cold Brew post is on the calendar for Saturday at 11:00, after your approval." }
      ]
    }
  }
}
