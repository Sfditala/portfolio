{
  "_placeholder": true,
  "id": "pizza-pickup-order",
  "projectSlug": "restaurant-voice-agent",
  "title": "A phone order for pickup",
  "prompt": "A caller orders 2 pizzas for pickup",
  "nodes": [
    { "id": "voice", "label": "Voice Agent", "kind": "voice", "icon": "elevenlabs", "position": { "x": 16, "y": 228 } },
    { "id": "mcp", "label": "MCP Server", "kind": "trigger", "icon": "mcp", "position": { "x": 229, "y": 228 } },
    { "id": "get_menu", "label": "get_menu", "kind": "tool", "icon": "tool", "position": { "x": 442, "y": 100 } },
    { "id": "create_order", "label": "create_order", "kind": "tool", "icon": "tool", "position": { "x": 442, "y": 360 } },
    { "id": "sheets", "label": "Google Sheets", "kind": "db", "icon": "sheets", "position": { "x": 655, "y": 228 } },
    { "id": "confirm", "label": "Confirmation", "kind": "output", "icon": "speaker", "position": { "x": 868, "y": 228 } }
  ],
  "edges": [
    { "from": "voice", "to": "mcp" },
    { "from": "mcp", "to": "get_menu" },
    { "from": "mcp", "to": "create_order" },
    { "from": "get_menu", "to": "sheets", "label": "read" },
    { "from": "create_order", "to": "sheets", "label": "append" },
    { "from": "sheets", "to": "confirm" }
  ],
  "steps": [
    {
      "nodeId": "voice",
      "durationMs": 1400,
      "log": "call connected · en",
      "view": "chat",
      "output": {
        "messages": [
          { "from": "bot", "text": "Hi, thanks for calling. What can I get for you today?" },
          { "from": "user", "text": "Can I get two pizzas for pickup? What do you have?" }
        ]
      }
    },
    {
      "nodeId": "mcp",
      "durationMs": 600,
      "log": "tools/call get_menu",
      "view": "json",
      "input": { "method": "tools/call", "tool": "get_menu" },
      "output": { "routed_to": "get_menu" }
    },
    {
      "nodeId": "get_menu",
      "durationMs": 900,
      "log": "4 pizzas available",
      "view": "table",
      "input": { "category": "pizza" },
      "output": {
        "columns": ["Item", "Available"],
        "rows": [
          ["Margherita", "yes"],
          ["Pepperoni", "yes"],
          ["Quattro Formaggi", "yes"],
          ["Veggie", "yes"]
        ]
      }
    },
    {
      "nodeId": "mcp",
      "durationMs": 1300,
      "log": "caller chose · tools/call create_order",
      "view": "chat",
      "output": {
        "messages": [
          { "from": "bot", "text": "We have Margherita, Pepperoni, Quattro Formaggi and Veggie." },
          { "from": "user", "text": "One Margherita and one Pepperoni, please. I'll pick up at seven." }
        ]
      }
    },
    {
      "nodeId": "create_order",
      "durationMs": 800,
      "log": "order validated",
      "view": "json",
      "input": {
        "items": [
          { "qty": 1, "name": "Margherita" },
          { "qty": 1, "name": "Pepperoni" }
        ],
        "type": "pickup",
        "pickup_time": "19:00"
      },
      "output": { "valid": true, "order_id": "A-1042" }
    },
    {
      "nodeId": "sheets",
      "durationMs": 800,
      "log": "append · 1 row",
      "view": "table",
      "input": { "operation": "append", "sheet": "Orders" },
      "output": {
        "columns": ["Order", "Items", "Type", "Pickup", "Status"],
        "rows": [["A-1042", "1 Margherita, 1 Pepperoni", "Pickup", "19:00", "New"]]
      }
    },
    {
      "nodeId": "confirm",
      "durationMs": 1000,
      "log": "spoken confirmation",
      "view": "audio",
      "output": {
        "transcript": "Perfect. One Margherita and one Pepperoni, ready for pickup at seven. Your order number is A-1042. See you soon!"
      }
    }
  ],
  "result": {
    "type": "order",
    "data": {
      "orderId": "A-1042",
      "items": [
        { "qty": 1, "name": "Margherita" },
        { "qty": 1, "name": "Pepperoni" }
      ],
      "orderType": "Pickup",
      "pickup": "19:00",
      "language": "English",
      "transcript": "Perfect. One Margherita and one Pepperoni, ready for pickup at seven. Your order number is A-1042. See you soon!"
    }
  }
}
