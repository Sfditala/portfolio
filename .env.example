# Server-only. Never prefix with NEXT_PUBLIC_.
GROQ_API_KEY=
# Optional. Default to openai/gpt-oss-120b and openai/gpt-oss-20b (used when the first is rate limited).
GROQ_MODEL=
GROQ_FALLBACK_MODEL=

# n8n booking webhook (Phase 4). The secret is sent as a header so n8n can verify the request.
N8N_BOOKING_WEBHOOK_URL=
N8N_BOOKING_WEBHOOK_SECRET=

# EmailJS fallback form (public by design).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Canonical site URL, e.g. https://talasafadi.com
NEXT_PUBLIC_SITE_URL=
